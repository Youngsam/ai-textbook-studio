# Copy this file to .env, then set the actual credentials locally.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DATABASE_URL=sqlite:///./data/learning.db

# A model available to your API account, with image input and streaming support.
# Initial provider: openai, claude, gemini, openrouter (fake for development only).
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
# Optional legacy model suggestions; models can now be entered freely in AI settings.
LLM_ALLOWED_MODELS=gpt-5.4-mini,gpt-5.4
LLM_SUPPORTS_IMAGES=true
# Relative paths resolve from the repository root, not the working directory.
DATA_DIR=./data
MAX_UPLOAD_BYTES=524288000
MAX_PDF_PAGES=2000
PDF_PROCESS_TIMEOUT_SECONDS=30
# Local contents recognition: inspect the first N PDF pages, no external AI request.
OUTLINE_MAX_PAGES=24
OUTLINE_TIMEOUT_SECONDS=120
OCR_LANGUAGE=kor+eng
# OCR_TESSDATA=/absolute/path/to/tessdata (default: .cache/tessdata in this project)
LLM_INPUT_TOKEN_BUDGET=12000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_SECONDS=120
# For trusted LAN access, explicitly add your server's IP/hostname and browser origin.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000,http://localhost:8000
